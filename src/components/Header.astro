---
import Mark from "./Mark.astro";
const { current = "" } = Astro.props;
const links = [
  { href: "/#packs", label: "Packs", id: "packs" },
  { href: "/packs/everyday-cars/#showroom", label: "Showroom", id: "showroom" },
  { href: "/packs/helicopters/", label: "Helicopters", id: "helicopters" },
  { href: "/contact.html", label: "Support", id: "support" },
];
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Saturday Cartridge, home" data-scramble>
    <Mark class="brand-mark" />
    <span class="brand-name" data-scramble-text>Saturday Cartridge</span>
  </a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={current === l.id ? "page" : undefined} data-scramble>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <time class="clock label num" data-clock aria-label="Local time">Sat 06:20</time>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .site-header > * {
    pointer-events: auto;
  }
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 620;
    font-stretch: 112%;
    letter-spacing: -0.02em;
  }
  .brand :global(.brand-mark) {
    width: 1.35rem;
    height: auto;
    transform: rotate(-8deg);
    transition: transform 600ms var(--spring);
  }
  .brand:hover :global(.brand-mark) {
    transform: rotate(0deg) translateY(-2px) scale(1.08);
  }
  ul {
    display: flex;
    gap: clamp(0.1rem, 1vw, 0.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    position: relative;
    display: block;
    padding: 0.45rem 0.55rem;
    font-size: 0.9375rem;
    font-weight: 500;
    font-stretch: 96%;
    text-decoration: none;
    border-radius: 999px;
    transition: background-color 250ms;
  }
  nav a::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: currentColor;
    transform: translateX(-50%) scale(0);
    transition: transform 400ms var(--spring);
  }
  nav a:hover::after {
    transform: translateX(-50%) scale(1);
  }
  nav a[aria-current="page"] {
    background: var(--ink);
    color: var(--paper);
  }
  nav a[aria-current="page"]::after {
    display: none;
  }
  .clock {
    min-width: 4.5rem;
    text-align: right;
    color: inherit;
    opacity: 0.7;
  }
  .clock :global(.clock-colon) {
    animation: blink 2s steps(1) infinite;
  }
  .clock[data-saturday="yes"] :global(.clock-day) {
    color: var(--sun-deep);
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 52rem) {
    .clock {
      display: none;
    }
    .site-header {
      grid-template-columns: 1fr auto;
    }
  }
  @media (max-width: 40rem) {
    .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    nav a {
      padding-inline: 0.4rem;
      font-size: 0.875rem;
    }
  }
</style>
