---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
---
<Base title="Page not found" description="This page could not be found.">
  <main id="main" class="lost">
    <button type="button" class="cart" aria-label="Blow on the cartridge">
      <Mark class="cart-mark" />
    </button>
    <h1>This page didn't load</h1>
    <p>Blow on the cartridge and try again, or head back to the start. The page you followed may have moved.</p>
    <div class="actions">
      <a class="btn btn-sun" href="/">Back to the start</a>
      <a class="btn btn-ghost" href="/contact.html">Contact support</a>
    </div>
  </main>
</Base>

<script>
  // a puff of air: the cartridge jiggles, like it always did
  const cart = document.querySelector(".cart");
  cart?.addEventListener("click", () => {
    cart.classList.remove("is-blown");
    void cart.offsetWidth;
    cart.classList.add("is-blown");
  });
</script>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.25rem;
    padding: calc(var(--header-h) + 2rem) var(--gutter) 4rem;
    max-width: 52rem;
  }
  .cart {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 8px;
  }
  .cart :global(.cart-mark) {
    width: clamp(5rem, 14vw, 8rem);
    height: auto;
    transform: rotate(-8deg);
  }
  .cart.is-blown :global(.cart-mark) {
    animation: blow 620ms cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  @keyframes blow {
    0% { transform: rotate(-8deg); }
    25% { transform: rotate(4deg) translateY(-6px); }
    50% { transform: rotate(-12deg) translateY(2px); }
    75% { transform: rotate(-4deg) translateY(-2px); }
    100% { transform: rotate(-8deg); }
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 820;
    font-stretch: 120%;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }
  p {
    max-width: 32rem;
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .cart.is-blown :global(.cart-mark) {
      animation: none;
    }
  }
</style>
