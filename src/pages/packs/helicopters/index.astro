---
import Base from "../../../layouts/Base.astro";
import fleet from "../../../data/helicopters.json";
import { packs } from "../../../data/packs.js";

const pack = packs.find((p) => p.id === "helicopters");
const n = (x) => x.toLocaleString("en-GB");
const img = (id, view, w) => `/assets/img/helicopters/${id}-${view}-${w}.webp`;
const first = fleet[0];
const minTris = Math.min(...fleet.map((h) => h.tris[0]));
const maxTris = Math.max(...fleet.map((h) => h.tris[0]));
const classes = ["Civil", "Utility", "Attack"];
const views = [
  { id: "front34", label: "Front ¾" },
  { id: "side", label: "Side" },
  { id: "rear34", label: "Rear ¾" },
];
const features = [
  { t: "Cockpits with crew", d: "Seats, panels, controls and static instruments behind tinted glass, with seated pilots in every aircraft." },
  { t: "Rotors that spin up", d: "Separate main and tail rotors on correct pivots, and blur discs that fade in with a single Power value." },
  { t: "Paint without textures", d: "A procedural URP paint shader draws mottle, streaks, camouflage, belly bands, grime and soot. A new scheme is a duplicated material." },
  { t: "Three LODs each", d: "A ready LOD Group per aircraft: 60,000 to 94,000 triangles at LOD0, cockpit and crew included, and 10,700 to 16,800 at LOD2." },
  { t: "Lights that bloom", d: "Navigation lights, beacons and screens in HDR, so they glow with your post-processing." },
  { t: "A studio to show them in", d: "A showcase scene with the whole fleet on a plain studio floor and an orbiting camera that spools up each aircraft in turn." },
];
const schemes = [
  { id: "AssaultGunship", caption: "Desert camouflage over a pale belly" },
  { id: "RescueTwin", caption: "Rescue red under white" },
  { id: "EscortAttack", caption: "Two-tone green-grey camouflage" },
  { id: "LightUtility", caption: "Civil white with a teal band" },
];
const gallery = [
  { src: "lods", w: 1600, h: 900, alt: "The same dark green utility helicopter three times side by side, at full, medium and low detail.", caption: "LOD0, LOD1 and LOD2 side by side." },
  { src: "cockpit", w: 1600, h: 900, alt: "A close look through the canopy of a tandem gunship at its two seated crew and cockpit panels.", caption: "Crew and cockpit behind the canopy glass." },
  { src: "fleet", w: 1600, h: 900, alt: "The full fleet of twelve helicopters spread over a plain blue-grey studio floor, seen from above.", caption: "The whole fleet in the showcase scene." },
];
const notify = "mailto:ifeonu95@gmail.com?subject=" + encodeURIComponent("Helicopter Pack launch");
---
<Base
  title="RotorTrail, Helicopter Pack"
  description="Twelve detailed helicopters for Unity URP with cockpits, crew, spinning rotors, three LODs and procedural paint. Coming soon to the Unity Asset Store."
  current="helicopters"
  image="/assets/img/helicopters/og.jpg"
>
  <main id="main">
    <!--
      The hangar, built like the Everyday Cars showroom. With WebGL 2 (hangar-live) the canvas fills the screen and
      the controls sit on it; without it, the same section is a flip-book of Unity captures.
    -->
    <section class="hangar" id="hangar" aria-labelledby="pack-title" data-aircraft={first.id} data-mood="noon">
      <canvas class="showroom-canvas" tabindex="0" data-cursor="Drag" aria-label="3D view of the selected aircraft. Drag to turn it, or use the left and right arrow keys to change aircraft."></canvas>

      <div class="hg-head">
        <h1 id="pack-title"><span class="hg-name">{pack.title}</span> <span class="hg-sub">{pack.subtitle}</span></h1>
        <p class="pill hg-status">{pack.status}</p>
      </div>

      <nav class="roster" aria-label="Aircraft">
        {classes.map((c) => (
          <div class="roster-group">
            <span class="label">{c}</span>
            <ul role="list">
              {fleet.filter((h) => h.cls === c).map((h) => (
                <li>
                  <button type="button" data-pick={h.id} aria-pressed={h.id === first.id ? "true" : "false"}>
                    <span>{h.title}</span>
                    <span class="tick" aria-hidden="true"></span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <div class="sr-bottom" data-live hidden>
        <label class="sr-power">
          <span class="sr-label">Rotor power <span class="num" data-power-out>0%</span></span>
          <input type="range" min="0" max="100" step="1" value="0" data-power aria-valuetext="Rotors stopped" />
        </label>
        <p class="sr-readout num" data-readout aria-live="polite"><strong>{first.title}</strong></p>
      </div>

      <div class="sr-inspect" data-live hidden>
        <div class="sr-group" role="group" aria-labelledby="g-lod">
          <p class="sr-label" id="g-lod">Level of detail</p>
          <div class="seg">
            {[0, 1, 2].map((i) => (
              <button type="button" data-lod={i} aria-pressed={i === 1 ? "true" : "false"}>LOD{i}<span class="tris num">{n(first.tris[i])}</span></button>
            ))}
          </div>
          <button type="button" class="chip" data-wire aria-pressed="false">Wireframe</button>
        </div>
        <div class="sr-group" role="group" aria-labelledby="g-view">
          <p class="sr-label" id="g-view">View</p>
          <div class="seg">
            {views.map((v, i) => (
              <button type="button" data-view={v.id} aria-pressed={i === 0 ? "true" : "false"}>{v.label}</button>
            ))}
          </div>
          <button type="button" class="chip" data-view="cockpit" aria-pressed="false">Pilot's seat</button>
        </div>
        <div class="sr-group" role="group" aria-labelledby="g-time">
          <p class="sr-label" id="g-time">Time of day</p>
          <div class="seg">
            <button type="button" data-mood="morning" aria-pressed="false">Morning</button>
            <button type="button" data-mood="noon" aria-pressed="true">Noon</button>
            <button type="button" data-mood="dusk" aria-pressed="false">Dusk</button>
            <button type="button" data-mood="night" aria-pressed="false">Night</button>
          </div>
        </div>
      </div>

      <span class="sr-status label" data-status aria-live="polite"></span>

      <div class="stage-wrap" data-fallback>
        <div class="stage" tabindex="0" role="img" data-stage data-cursor="Drag" aria-label={`${first.title}, front three-quarter view. Drag or use the left and right arrow keys to turn it.`}>
          <img class="frame is-shown" src={img(first.id, "front34", 1280)} srcset={`${img(first.id, "front34", 720)} 720w, ${img(first.id, "front34", 1280)} 1280w`} sizes="(min-width: 64rem) 52rem, 100vw" width="1280" height="720" alt="" draggable="false" fetchpriority="high" />
          <img class="frame" alt="" width="1280" height="720" draggable="false" sizes="(min-width: 64rem) 52rem, 100vw" />
          <span class="stage-hint label" aria-hidden="true">Drag to turn</span>
        </div>
        <div class="stage-bar">
          <div class="views" role="group" aria-label="View">
            {views.map((v, i) => (
              <button type="button" data-view={v.id} aria-pressed={i === 0 ? "true" : "false"}>{v.label}</button>
            ))}
          </div>
          <label class="switch">
            <input type="checkbox" data-spin />
            <span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
            <span class="rotor" aria-hidden="true">
              <svg viewBox="0 0 24 24"><g><rect x="11" y="1" width="2" height="22" rx="1" /><rect x="1" y="11" width="22" height="2" rx="1" /></g><circle cx="12" cy="12" r="2.6" /></svg>
            </span>
            Spin up rotors
          </label>
        </div>
      </div>

      <div class="readout" aria-live="polite" data-fallback>
        <span class="label" data-r="cls">{first.cls}</span>
        <h2 class="readout-title" data-r="title">{first.title}</h2>
        <p data-r="line">{first.line}</p>
        <dl>
          <div><dt class="label">LOD0</dt><dd class="num" data-r="t0">{n(first.tris[0])}</dd></div>
          <div><dt class="label">LOD1</dt><dd class="num" data-r="t1">{n(first.tris[1])}</dd></div>
          <div><dt class="label">LOD2</dt><dd class="num" data-r="t2">{n(first.tris[2])}</dd></div>
          <div class="wide"><dt class="label">Body L × W × H</dt><dd class="num" data-r="size">{first.length.toFixed(2)} × {first.width.toFixed(2)} × {first.height.toFixed(2)} m</dd></div>
        </dl>
      </div>
    </section>

    <section class="wrap intro" aria-labelledby="intro-title">
      <div class="intro-head">
        <span class="label" data-reveal>{pack.no} <span aria-hidden="true">/</span> {pack.engine} <span aria-hidden="true">/</span> URP</span>
        <h2 id="intro-title" data-reveal style="--i: 1">Twelve aircraft, one look</h2>
        <div class="intro-side" data-reveal style="--i: 2">
          <p>{pack.summary} Every one shares the same paint shaders, so the fleet looks of a piece in any scene.</p>
          <a class="btn btn-ghost" href={notify} data-magnetic>Tell me when it lands</a>
        </div>
      </div>
      <figure class="intro-media" data-reveal style="--i: 3">
        <img
          src="/assets/img/helicopters/lineup-1600.webp"
          srcset="/assets/img/helicopters/lineup-800.webp 800w, /assets/img/helicopters/lineup-1600.webp 1600w"
          sizes="(min-width: 84rem) 80rem, 100vw"
          width="1600"
          height="900"
          loading="lazy"
          alt="Six helicopters in a shallow V on a plain blue-grey studio floor: a red firefighter, a desert-camouflage gunship, a dark green gunship, a white and red rescue twin with its rotor spinning, an olive tandem-rotor transport and a dark green utility helicopter."
        />
      </figure>
    </section>

    <section class="wrap features" aria-labelledby="features-title">
      <div class="section-head">
        <span class="label">In the box</span>
        <h2 id="features-title">Ready for a scene, not a cleanup</h2>
      </div>
      <ol class="feature-list" role="list">
        {features.map((f, i) => (
          <li data-reveal style={`--i: ${i % 3}`}>
            <span class="label num">0{i + 1}</span>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap schemes" aria-labelledby="schemes-title">
      <div class="section-head">
        <span class="label">Paint</span>
        <h2 id="schemes-title">Schemes drawn by a shader</h2>
      </div>
      <p class="schemes-note" data-reveal>
        No texture sets: one material per surface holds the colours, camouflage, belly line, grime and exhaust soot, so the
        pack stays small and every scheme is yours to change.
      </p>
      <ul class="scheme-strip" role="list">
        {schemes.map((s, i) => {
          const h = fleet.find((x) => x.id === s.id);
          return (
            <li data-reveal style={`--i: ${i}`}>
              <button type="button" class="scheme" data-jump={s.id} data-cursor="Inspect">
                <span class="scheme-media"><img src={img(s.id, "side", 720)} width="720" height="405" loading="lazy" alt={`${h.title}, side view: ${s.caption.toLowerCase()}.`} /></span>
                <span class="scheme-cap"><strong>{h.title}</strong> {s.caption}</span>
              </button>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="wrap gallery" aria-label="More captures">
      {gallery.map((g, i) => (
        <figure class={i === 2 ? "wide" : undefined} data-reveal style={`--i: ${i}`}>
          <img src={`/assets/img/helicopters/${g.src}-1600.webp`} srcset={`/assets/img/helicopters/${g.src}-800.webp 800w, /assets/img/helicopters/${g.src}-1600.webp 1600w`} sizes={i === 2 ? "(min-width: 84rem) 80rem, 100vw" : "(min-width: 48rem) 50vw, 100vw"} width={g.w} height={g.h} loading="lazy" alt={g.alt} />
          <figcaption class="label">{g.caption}</figcaption>
        </figure>
      ))}
    </section>

    <section class="wrap specs" aria-labelledby="specs-title">
      <div class="section-head">
        <span class="label">Specs</span>
        <h2 id="specs-title">The fleet in numbers</h2>
      </div>
      <dl class="facts">
        <div data-reveal><dt class="label">Aircraft</dt><dd><strong class="num" data-count="12">12</strong> with 3 LODs each</dd></div>
        <div data-reveal style="--i: 1"><dt class="label">Triangles at LOD0</dt><dd class="num">{n(minTris)} to {n(maxTris)}</dd></div>
        <div data-reveal style="--i: 2"><dt class="label">Render pipeline</dt><dd>URP 17.6 or newer</dd></div>
        <div data-reveal style="--i: 3"><dt class="label">Unity</dt><dd>6000.6 or newer</dd></div>
      </dl>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Aircraft</th>
              <th scope="col">Class</th>
              <th scope="col" class="r">LOD0</th>
              <th scope="col" class="r">LOD1</th>
              <th scope="col" class="r">LOD2</th>
              <th scope="col" class="r">Body L × W × H</th>
            </tr>
          </thead>
          <tbody>
            {fleet.map((h) => (
              <tr>
                <th scope="row"><a class="link" href="#hangar" data-jump={h.id} data-preview={img(h.id, "front34", 720)}>{h.title}</a></th>
                <td>{h.cls}</td>
                <td class="r num">{n(h.tris[0])}</td>
                <td class="r num">{n(h.tris[1])}</td>
                <td class="r num">{n(h.tris[2])}</td>
                <td class="r num">{h.length.toFixed(2)} × {h.width.toFixed(2)} × {h.height.toFixed(2)} m</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">Triangles as Unity imports them, for the whole aircraft at each level: cockpit, crew and every blade included.</p>
    </section>

    <section class="wrap notes" aria-labelledby="notes-title">
      <div>
        <h2 id="notes-title" class="notes-title">Good to know</h2>
        <ul>
          <li>URP only. The Built-in render pipeline and HDRP are not supported.</li>
          <li>Art only: there is no flight controller, weapons logic or audio. Rotors spin through an optional component with no physics.</li>
          <li>Doors and canopies are part of the body and do not open. The crew are static meshes without a rig.</li>
          <li>Cockpit instruments are static artwork, not working gauges.</li>
          <li>Each part is its own renderer: 86 to 111 draw calls per aircraft. Plan to combine meshes for large fleets or mobile.</li>
        </ul>
      </div>
      <div class="notes-cta" data-cursor-dark>
        <span class="pill">{pack.status}</span>
        <p>Want a note the day it is on the store, or have a question first? Email us and we will reply within two business days.</p>
        <a class="btn btn-sun" href={notify} data-magnetic>Tell me when it lands <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</Base>

<script>
  import { startHangar } from "../../../scripts/hangar.js";
  import fleet from "../../../data/helicopters.json";
  const el = document.getElementById("hangar");
  if (el) startHangar(el, fleet);
</script>

<style>
  /* ---- The hangar ------------------------------------------------------------------------------------
     Without WebGL 2: a grid of roster, captured views and readout. Live (.hangar-live): the canvas fills the
     screen and the controls sit on it, as in the Everyday Cars showroom. */
  .hangar [hidden] {
    display: none !important;
  }
  .hangar {
    position: relative;
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr) 16rem;
    grid-template-areas:
      "head head head"
      "roster stage readout";
    gap: 2rem clamp(1.25rem, 2.5vw, 2.5rem);
    padding: calc(var(--header-h) + clamp(1.5rem, 4vh, 3rem)) max(var(--gutter), calc((100% - 84rem) / 2 + var(--gutter)))
      clamp(3rem, 7vw, 5rem);
    background: var(--paper-2);
  }
  .showroom-canvas {
    display: none;
  }
  .hg-head {
    grid-area: head;
  }
  h1 {
    display: grid;
    line-height: 0.9;
  }
  .hg-name {
    font-size: var(--step-4);
    font-weight: 560;
    font-stretch: 120%;
    letter-spacing: -0.045em;
  }
  .hg-sub {
    margin-top: 0.35rem;
    font-size: var(--step-1);
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: -0.01em;
  }
  .hg-status {
    margin-top: 0.85rem;
  }

  .roster {
    grid-area: roster;
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }
  .roster-group {
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }
  .roster ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .roster button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.38rem 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 480;
    font-stretch: 98%;
    text-align: left;
    cursor: pointer;
    transition: color 250ms, padding 450ms var(--ease), background-color 250ms;
  }
  .roster button:hover {
    color: var(--ink);
    padding-left: 0.35rem;
  }
  .roster button[aria-pressed="true"] {
    color: var(--ink);
    font-weight: 600;
  }
  .tick {
    width: 1.25rem;
    height: 2px;
    background: var(--sun-deep);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 500ms var(--ease);
  }
  .roster button[aria-pressed="true"] .tick {
    transform: scaleX(1);
  }

  .stage-wrap {
    grid-area: stage;
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: var(--studio);
    box-shadow: 0 30px 60px -40px rgb(21 23 28 / 0.5);
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
  }
  .stage:active {
    cursor: grabbing;
  }
  .frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    scale: 1.015;
    transition:
      opacity 420ms var(--ease),
      scale 900ms var(--ease);
  }
  .frame.is-shown {
    opacity: 1;
    scale: 1;
  }
  .stage-hint {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    color: rgb(255 255 255 / 0.85);
    transition: opacity 500ms;
  }
  .stage.was-dragged .stage-hint {
    opacity: 0;
  }
  .stage-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .views {
    display: flex;
    padding: 0.2rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    transition: opacity 400ms;
  }
  .views button {
    padding: 0.35rem 0.85rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 550;
    cursor: pointer;
    transition: background-color 300ms, color 300ms;
  }
  .views button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
  }
  .hangar[data-spinning] .views {
    opacity: 0.45;
  }
  .switch {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
    font-weight: 550;
    cursor: pointer;
  }
  .switch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .switch-track {
    position: relative;
    width: 2.4rem;
    height: 1.35rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    transition: background-color 300ms, border-color 300ms;
  }
  .switch-knob {
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: var(--ink);
    transition: transform 450ms var(--spring);
  }
  .switch input:checked + .switch-track {
    background: var(--sun);
    border-color: var(--sun);
  }
  .switch input:checked + .switch-track .switch-knob {
    transform: translateX(1.05rem);
  }
  .switch input:focus-visible + .switch-track {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .rotor svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }
  .rotor g {
    transform-origin: 12px 12px;
    transition: transform 1s var(--ease);
  }
  .switch input:checked ~ .rotor g {
    animation: spin 0.35s linear infinite;
  }
  .switch:hover input:not(:checked) ~ .rotor g {
    transform: rotate(45deg);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .readout {
    grid-area: readout;
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }
  .readout-title {
    font-size: var(--step-2);
    font-weight: 560;
    font-stretch: 112%;
    letter-spacing: -0.03em;
  }
  .readout p {
    color: var(--muted);
    min-height: 4.6em;
  }
  .readout dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem 0.75rem;
    margin: 0.5rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .readout dl div {
    display: grid;
    gap: 0.15rem;
  }
  .readout .wide {
    grid-column: 1 / -1;
  }
  .readout dd {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .readout .wide dd {
    font-size: var(--step-0);
  }

  @media (max-width: 70rem) {
    .hangar {
      grid-template-columns: 12rem minmax(0, 1fr);
      grid-template-areas:
        "head head"
        "roster stage"
        "roster readout";
    }
  }
  @media (max-width: 46rem) {
    .hangar {
      grid-template-columns: 1fr;
      grid-template-areas:
        "head"
        "stage"
        "roster"
        "readout";
    }
    .roster {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .roster button {
      font-size: var(--step--1);
    }
    .tick {
      display: none;
    }
  }

  /* ---- Live: the showroom ---- */
  .hangar.hangar-live {
    display: block;
    height: 100svh;
    min-height: 40rem;
    padding: 0;
    overflow: hidden;
    background: #516488;
