---
import Base from "../../../layouts/Base.astro";
import vehicles from "../../../data/everyday-cars.json";
import { PAINTS } from "../../../data/paints.js";
import { packs } from "../../../data/packs.js";

const pack = packs.find((p) => p.id === "everyday-cars");
const n = (x) => x.toLocaleString("en-GB");
const prefabCount = 269;
const minTris = Math.min(...vehicles.map((v) => v.tris[0]));
const maxTris = Math.max(...vehicles.map((v) => v.tris[0]));
const gallery = [
  { src: "lineup", w: 1800, h: 900, alt: "The whole line-up parked in a loose group, from a yellow hatchback to a red semi truck with a box trailer.", caption: "Thirteen vehicles and a trailer in one consistent style." },
  { src: "colours", w: 1200, h: 675, alt: "Twenty hatchbacks parked in rows, each in a different paint colour.", caption: "17 paints for every model, each a single material swap." },
  { src: "interior", w: 1200, h: 675, alt: "A beige SUV from above, its seats and dashboard visible through the glass.", caption: "Seats, dashboard and steering wheel behind tinted glass." },
  { src: "lights", w: 1200, h: 675, alt: "A pickup, a sedan and a sports coupe at night with headlights and tail lights on.", caption: "Lamps you can switch from your own scripts." },
];
---
<Base
  title="Everyday Cars, Low Poly Vehicle Pack"
  description="Thirteen low poly road vehicles and a semi-trailer for Unity, with interiors, separate wheels, working lamps, three LODs and 17 paints each. Try every model in the showroom."
  current="showroom"
>
  <main id="main">
    <section class="showroom" id="showroom" aria-labelledby="pack-title" data-vehicle="Hatchback">
      <canvas class="showroom-canvas" tabindex="0" aria-label="3D view of the selected vehicle. Drag to turn it, or use the left and right arrow keys to change vehicle."></canvas>

      <div class="sr-head">
        <h1 id="pack-title"><span class="sr-name">Everyday Cars</span> <span class="sr-sub">Low Poly Vehicle Pack</span></h1>
        <p class="sr-status">{pack.status}</p>
      </div>

      <nav class="sr-vehicles" aria-label="Vehicles">
        <ul role="list">
          {vehicles.map((v) => (
            <li><button type="button" data-vehicle={v.id} aria-pressed={v.id === "Hatchback" ? "true" : "false"}>{v.title.replace(" (Tractor Unit)", "")}</button></li>
          ))}
        </ul>
      </nav>

      <div class="sr-bottom">
        <div class="sr-paint" role="group" aria-label="Paint">
          <p class="sr-label">Paint <span data-paint-name>Yellow</span></p>
          <div class="swatches">
            {PAINTS.map((p) => (
              <button type="button" class="swatch" data-paint={p.name} style={`--c: ${p.hex}`} aria-pressed={p.name === "Yellow" ? "true" : "false"} aria-label={p.name.replace("_", " ")}></button>
            ))}
          </div>
        </div>
        <p class="sr-readout num" data-readout aria-live="polite"><strong>Compact Hatchback</strong></p>
      </div>

      <div class="sr-inspect">
        <div class="sr-group" role="group" aria-labelledby="g-lod">
          <p class="sr-label" id="g-lod">Level of detail</p>
          <div class="seg">
            {[0, 1, 2].map((i) => (
              <button type="button" data-lod={i} aria-pressed={i === 0 ? "true" : "false"}>LOD{i}<span class="tris num"></span></button>
            ))}
          </div>
          <button type="button" class="chip" data-toggle="wire" aria-pressed="false">Wireframe</button>
        </div>
        <div class="sr-group" role="group" aria-labelledby="g-lamps">
          <p class="sr-label" id="g-lamps">Lamps</p>
          <div class="chips">
            <button type="button" class="chip" data-toggle="head" aria-pressed="false">Headlights</button>
            <button type="button" class="chip" data-toggle="brake" aria-pressed="false">Brake</button>
            <button type="button" class="chip" data-toggle="reverse" aria-pressed="false">Reverse</button>
            <button type="button" class="chip" data-toggle="left" aria-pressed="false">Left</button>
            <button type="button" class="chip" data-toggle="right" aria-pressed="false">Right</button>
            <button type="button" class="chip" data-toggle="hazard" aria-pressed="false">Hazards</button>
          </div>
          <button type="button" class="chip" data-toggle="trailer" aria-pressed="true" hidden>Trailer</button>
        </div>
        <div class="sr-group" role="group" aria-labelledby="g-time">
          <p class="sr-label" id="g-time">Time of day</p>
          <div class="seg">
            <button type="button" data-mood="morning" aria-pressed="false">Morning</button>
            <button type="button" data-mood="noon" aria-pressed="true">Noon</button>
            <button type="button" data-mood="dusk" aria-pressed="false">Dusk</button>
            <button type="button" data-mood="night" aria-pressed="false">Night</button>
          </div>
        </div>
      </div>

      <img class="sr-fallback" src="/assets/img/lineup-1800.webp" srcset="/assets/img/lineup-960.webp 960w, /assets/img/lineup-1800.webp 1800w" sizes="100vw" width="1800" height="900" alt="The Everyday Cars line-up parked in a loose group." />
    </section>

    <section class="pack-body">
      <div class="wrap intro">
        <div class="intro-copy">
          <h2>Traffic, car parks and garages, ready to fill</h2>
          <p>
            Thirteen road vehicles and a box semi-trailer in one glossy, consistent style, from a compact hatchback to a
            semi truck. Every vehicle has a full interior behind see-through glass, separate wheels, working lamps and
            three levels of detail, and comes ready as prefabs in 17 colours.
          </p>
          <p>
            They share one material library, so a whole street costs few draw calls and a new paint colour is one
            material. Drop them into traffic, car parks, garages or menus.
          </p>
        </div>
        <dl class="facts">
          <div><dt>Vehicles</dt><dd>13, plus a box semi-trailer</dd></div>
          <div><dt>Prefabs</dt><dd>{prefabCount}, including truck-and-trailer sets</dd></div>
          <div><dt>Levels of detail</dt><dd>3 per vehicle, LOD Group set up</dd></div>
          <div><dt>Triangles at LOD0</dt><dd class="num">{n(minTris)} to {n(maxTris)}</dd></div>
          <div><dt>Render pipelines</dt><dd>URP, and Built-in through an included package</dd></div>
          <div><dt>Unity</dt><dd>2022.3 or newer, including Unity 6</dd></div>
          <div><dt>Textures</dt><dd>None: solid-colour materials, about 15 MB in all</dd></div>
        </dl>
      </div>

      <div class="wrap lineup" id="lineup">
        <h2>The line-up</h2>
        <p class="lineup-note">Select a vehicle to load it in the showroom.</p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Vehicle</th>
                <th scope="col" class="r">LOD0</th>
                <th scope="col" class="r">LOD1</th>
                <th scope="col" class="r">LOD2</th>
                <th scope="col" class="r">Length × width × height</th>
              </tr>
            </thead>
            <tbody>
              {vehicles.map((v) => (
                <tr>
                  <th scope="row"><a href="#showroom" data-show-vehicle={v.id}>{v.title}</a></th>
                  <td class="r num">{n(v.tris[0])}</td>
                  <td class="r num">{n(v.tris[1])}</td>
                  <td class="r num">{n(v.tris[2])}</td>
                  <td class="r num">{v.length.toFixed(2)} × {v.width.toFixed(2)} × {v.height.toFixed(2)} m</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="lineup-note">Triangle counts are for the whole vehicle at each level, wheels and interior included.</p>
      </div>

      <div class="wrap gallery">
        {gallery.map((g, i) => (
          <figure class={i === 0 ? "wide" : undefined}>
            <img
              src={`/assets/img/${g.src}-${g.w === 1800 ? 1800 : 1200}.webp`}
              srcset={g.w === 1800 ? `/assets/img/${g.src}-960.webp 960w, /assets/img/${g.src}-1800.webp 1800w` : `/assets/img/${g.src}-640.webp 640w, /assets/img/${g.src}-1200.webp 1200w`}
              sizes={i === 0 ? "(min-width: 82rem) 78rem, 100vw" : "(min-width: 48rem) 50vw, 100vw"}
              width={g.w}
              height={g.h}
              loading="lazy"
              alt={g.alt}
            />
            <figcaption>{g.caption}</figcaption>
          </figure>
        ))}
      </div>

      <div class="wrap notes">
        <div>
          <h2>Good to know</h2>
          <ul>
            <li>There are no textures or UVs, so texture-based liveries and decals are not supported out of the box.</li>
            <li>Doors, bonnet and boot are part of the body and do not open.</li>
            <li>The pack is art only: no driving physics or vehicle controller. Wheels and the steering wheel have correct pivots for your own controller.</li>
          </ul>
        </div>
        <div class="notes-cta">
          <p class="sr-status">{pack.status}</p>
          <p>Questions before you buy, or help after? Support answers within two business days.</p>
          <a class="btn btn-sun" href="/contact.html">Contact support</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { startShowroom } from "../../../three/showroom.js";
  const el = document.getElementById("showroom");
  if (el) startShowroom(el);
</script>

<style>
  .showroom {
    position: relative;
    padding: calc(var(--header-h) + 1rem) var(--gutter) 2rem;
    background: var(--slate);
    display: grid;
    gap: 1.5rem;
  }
  .showroom-canvas,
  .sr-vehicles,
  .sr-bottom,
  .sr-inspect {
    display: none;
  }
  .sr-fallback {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  h1 {
    display: grid;
    line-height: 0.9;
  }
  .sr-name {
    font-size: var(--step-4);
    font-weight: 820;
    font-stretch: 122%;
    letter-spacing: -0.03em;
  }
  .sr-sub {
    margin-top: 0.35rem;
    font-size: var(--step-1);
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: -0.01em;
  }
  .sr-status {
    display: inline-block;
    margin-top: 0.85rem;
    padding: 0.25rem 0.65rem 0.3rem;
    background: var(--ink);
    color: var(--sun);
    border-radius: 6px;
    font-size: var(--step--1);
    font-weight: 650;
    font-stretch: 92%;
  }

  /* live showroom: canvas fills the screen, controls sit on it like a garage menu */
  :global(.showroom-live).showroom {
    display: block;
    height: 100svh;
    min-height: 40rem;
    padding: 0;
    overflow: hidden;
    transition: background-color 600ms;
  }
  :global(.showroom-live) .sr-fallback {
    display: none;
  }
  :global(.showroom-live) .showroom-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: grab;
  }
  :global(.showroom-live) .showroom-canvas:active {
    cursor: grabbing;
  }
  :global(.showroom-live) .showroom-canvas:focus-visible {
    outline-offset: -6px;
  }
  :global(.showroom-live) .sr-head {
    position: absolute;
    left: var(--gutter);
    top: calc(var(--header-h) + 0.5rem);
  }
  :global(.showroom-live[data-mood="night"]) {
    --focus: var(--sun);
  }
  /* the section matches the studio backdrop, which shows around the canvas on small screens */
  :global(.showroom-live[data-mood="morning"]) {
    background: #b3bcd5;
  }
  :global(.showroom-live[data-mood="dusk"]) {
    background: #a98593;
  }
  :global(.showroom-live[data-mood="night"]) {
    background: var(--ink);
  }
  :global(.showroom-live[data-mood="night"]) h1 {
    color: var(--paper);
  }
  :global(body:has(.showroom-live[data-mood="night"]) .site-header) {
    color: var(--paper);
    --focus: var(--sun);
  }

  :global(.showroom-live) .sr-vehicles {
    display: block;
    position: absolute;
    left: var(--gutter);
    top: calc(var(--header-h) + 9.5rem);
    bottom: 9.5rem;
    width: 13.5rem;
    overflow: auto;
    scrollbar-width: thin;
  }
  .sr-vehicles ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sr-vehicles button {
    width: 100%;
    padding: 0.42rem 0.7rem;
    border: 2px solid transparent;
    border-radius: 8px;
    background: rgb(237 240 246 / 0.82);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 96%;
    text-align: left;
    cursor: pointer;
  }
  .sr-vehicles button:hover {
    border-color: var(--ink);
  }
  .sr-vehicles button[aria-pressed="true"] {
    background: var(--sun);
    border-color: var(--ink);
    box-shadow: 0 3px 0 var(--ink);
  }

  :global(.showroom-live) .sr-bottom {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: min(40rem, calc(100% - 2 * var(--gutter)));
    transform: translateX(-50%);
  }
  .sr-paint {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem 0.8rem;
    background: rgb(237 240 246 / 0.94);
    border: 2px solid var(--ink);
    border-radius: 14px;
    box-shadow: 0 5px 0 var(--ink);
  }
  .swatches {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
  }
  .swatch {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--c);
    cursor: pointer;
    padding: 0;
    transition: transform 120ms;
  }
  .swatch:hover {
    transform: translateY(-2px);
  }
  .swatch[aria-pressed="true"] {
    box-shadow:
      0 0 0 2px var(--paper),
      0 0 0 4px var(--ink);
  }
  .sr-label {
    font-size: var(--step--1);
    font-weight: 700;
    font-stretch: 92%;
  }
  .sr-label span {
    font-weight: 500;
  }
  .sr-readout {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem 1rem;
    padding: 0.4rem 0.8rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 8px;
    font-size: var(--step--1);
  }
  .sr-readout :global(strong) {
    color: var(--sun);
  }

  :global(.showroom-live) .sr-inspect {
    display: grid;
    gap: 0.9rem;
    position: absolute;
    right: var(--gutter);
    top: calc(var(--header-h) + 0.5rem);
    width: 15.5rem;
    padding: 1rem 1rem 1.1rem;
    background: rgb(237 240 246 / 0.94);
    border: 2px solid var(--ink);
    border-radius: 14px;
    box-shadow: 0 5px 0 var(--ink);
  }
  .sr-group {
    display: grid;
    gap: 0.45rem;
  }
  .seg {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    border: 2px solid var(--ink);
    border-radius: 9px;
    overflow: hidden;
  }
  .seg button {
    display: grid;
    padding: 0.4rem 0.2rem;
    border: 0;
    border-left: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 650;
    font-stretch: 92%;
    cursor: pointer;
  }
  .seg button:first-child {
    border-left: 0;
  }
  .seg button:hover {
    background: var(--white);
  }
  .seg button[aria-pressed="true"] {
    background: var(--sun);
  }
  .seg .tris {
    font-size: 0.6875rem;
    font-weight: 500;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .chip {
    padding: 0.3rem 0.6rem;
    border: 2px solid var(--ink);
    border-radius: 7px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 620;
    font-stretch: 94%;
    cursor: pointer;
    justify-self: start;
  }
  .chip:hover {
    background: var(--white);
  }
  .chip[aria-pressed="true"] {
    background: var(--ink);
    color: var(--sun);
  }
  :global(.showroom-live.is-loading) .showroom-canvas {
    cursor: progress;
  }

  @media (max-width: 62rem), (orientation: portrait) {
    :global(.showroom-live).showroom {
      display: grid;
      grid-template-rows: auto auto;
      height: auto;
      min-height: 0;
      padding: calc(var(--header-h) + 0.25rem) 0 1.5rem;
    }
    :global(.showroom-live) .showroom-canvas {
      position: relative;
      grid-row: 2;
      height: 56svh;
    }
    :global(.showroom-live) .sr-head {
      position: static;
      grid-row: 1;
      padding-inline: var(--gutter);
    }
    :global(.showroom-live) .sr-vehicles {
      position: static;
      grid-row: 3;
      width: auto;
      overflow-x: auto;
      padding: 0.75rem var(--gutter) 0.5rem;
    }
    .sr-vehicles ul {
      display: flex;
      width: max-content;
    }
    .sr-vehicles button {
      white-space: nowrap;
    }
    :global(.showroom-live) .sr-bottom {
      position: static;
      grid-row: 4;
      transform: none;
      width: auto;
      margin: 0.5rem var(--gutter) 0;
    }
    :global(.showroom-live) .sr-inspect {
      position: static;
      grid-row: 5;
      width: auto;
      margin: 1rem var(--gutter) 0;
    }
    :global(.showroom-live[data-mood="night"]) .sr-paint .sr-label {
      color: var(--ink);
    }
  }

  /* below the showroom */
  .pack-body {
    background: var(--paper);
    padding-block: clamp(3rem, 7vw, 6rem);
    display: grid;
    gap: clamp(3.5rem, 8vw, 6.5rem);
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 2.5rem 4rem;
    align-items: start;
  }
  .intro-copy {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
  }
  .intro h2 {
    font-size: var(--step-3);
    margin-bottom: 0.25rem;
  }
  .facts {
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  .facts div {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--mist);
  }
  .facts dt {
    font-weight: 680;
    font-stretch: 96%;
  }
  .facts dd {
    margin: 0;
  }

  .lineup h2,
  .notes h2 {
    font-size: var(--step-3);
    margin-bottom: 0.5rem;
  }
  .lineup-note {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .table-wrap {
    margin-block: 1rem 0.75rem;
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    min-width: 40rem;
  }
  th,
  td {
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--mist);
    text-align: left;
    font-weight: 450;
  }
  thead th {
    border-bottom: 2px solid var(--ink);
    font-weight: 700;
    font-stretch: 94%;
    font-size: var(--step--1);
  }
  tbody th a {
    font-weight: 650;
  }
  tbody tr:hover {
    background: rgb(255 201 74 / 0.22);
  }
  .r {
    text-align: right;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .gallery .wide {
    grid-column: 1 / -1;
  }
  figure {
    margin: 0;
  }
  figure img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 2px solid var(--ink);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .notes {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2.5rem 4rem;
  }
  .notes ul {
    display: grid;
    gap: 0.6rem;
    margin: 0.75rem 0 0;
    padding-left: 1.1rem;
    max-width: 36rem;
  }
  .notes-cta {
    display: grid;
    gap: 1rem;
    justify-items: start;
    align-content: start;
    padding: 1.5rem;
    border: 2px solid var(--ink);
    border-radius: 14px;
    background: var(--white);
    box-shadow: 0 5px 0 var(--ink);
  }
  .notes-cta .sr-status {
    margin: 0;
  }
  @media (max-width: 52rem) {
    .intro,
    .notes {
      grid-template-columns: 1fr;
    }
    .gallery {
      grid-template-columns: 1fr;
    }
    .facts div {
      grid-template-columns: 8.5rem 1fr;
    }
  }
</style>
