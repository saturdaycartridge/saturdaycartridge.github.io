---
import Base from "../layouts/Base.astro";
import { packs } from "../data/packs.js";

const released = packs.filter((p) => p.href);
const cards = {
  "everyday-cars": {
    src: "/assets/img/lineup-1800.webp",
    srcset: "/assets/img/lineup-960.webp 960w, /assets/img/lineup-1800.webp 1800w",
    w: 1800,
    h: 900,
    alt: "The Everyday Cars line-up parked in a loose group, from a yellow hatchback to a red semi truck with a box trailer.",
    cta: "Open the showroom",
  },
  helicopters: {
    src: "/assets/img/helicopters/cover-1600.webp",
    srcset: "/assets/img/helicopters/cover-800.webp 800w, /assets/img/helicopters/cover-1600.webp 1600w",
    w: 1600,
    h: 1067,
    alt: "Six helicopters in a shallow V on a plain blue-grey studio floor: a red firefighter, a desert-camouflage gunship, a dark green gunship, a white and red rescue twin, an olive tandem-rotor transport and a dark green utility helicopter.",
    cta: "Walk around the fleet",
  },
};
const method = [
  { t: "Topology you can keep working on", d: "Clean, deliberate meshes that open in Blender or Maya ready for your own changes, not a tangle to clean up first." },
  { t: "Levels of detail that hold their shape", d: "Three LODs per model with a ready LOD Group, checked at the distances they switch, so silhouettes survive." },
  { t: "Prefabs that are ready to place", d: "Materials, colliders, pivots and components come set up. Drag a prefab into a scene and it already looks right." },
  { t: "Documented and answered", d: "Every pack ships with a README that tells you what is in it and what is not. Support replies within two business days." },
];
---
<Base current="home">
  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <p class="label hero-kicker" data-reveal>Game-ready 3D assets for Unity <span aria-hidden="true">/</span> Unreal Engine on the way</p>
      <h1 class="wordmark" id="hero-title" data-wordmark data-cursor-hover>Saturday Cartridge</h1>
      <div class="hero-foot">
        <p class="lede" data-reveal style="--i: 2">
          We make tidy, documented 3D asset packs. Every model arrives with its LODs, materials and prefabs set up,
          ready to drop into a scene.
        </p>
        <div class="hero-actions" data-reveal style="--i: 3">
          <a class="btn" href="#packs" data-magnetic>See the packs <span class="arrow" aria-hidden="true">↓</span></a>
          <a class="btn btn-ghost" href="/packs/helicopters/" data-magnetic>New: helicopters <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="wrap packs" id="packs" aria-labelledby="packs-title">
      <div class="section-head">
        <span class="label">Index</span>
        <h2 id="packs-title">Packs</h2>
      </div>
      <ol class="pack-list" role="list">
        {packs.map((p, i) => (
          <li data-reveal style={`--i: ${i}`}>
            {p.href ? (
              <a class="pack-row" href={p.href} data-preview={p.preview} data-cursor="View">
                <span class="label no num">{p.no}</span>
                <span class="row-title">
                  <span class="row-name">{p.title}</span>
                  <span class="row-sub">{p.subtitle}</span>
                </span>
                <span class="label row-engine">{p.engine}</span>
                <span class="pill">{p.status}</span>
                <span class="row-arrow" aria-hidden="true">→</span>
              </a>
            ) : (
              <div class="pack-row is-quiet">
                <span class="label no num">{p.no}</span>
                <span class="row-title">
                  <span class="row-name">{p.title}</span>
                  <span class="row-sub">{p.subtitle}</span>
                </span>
                <span class="label row-engine">{p.engine}</span>
                <span class="pill pill-quiet">{p.status}</span>
                <span class="row-arrow" aria-hidden="true"></span>
              </div>
            )}
          </li>
        ))}
      </ol>

      <div class="cards">
        {released.map((p, i) => {
          const c = cards[p.id];
          return (
            <a class="card" href={p.href} data-tilt="3" data-cursor={i ? "Enter" : "Drive"} data-reveal style={`--i: ${i}`}>
              <div class="card-media">
                <img src={c.src} srcset={c.srcset} sizes="(min-width: 64rem) 42rem, 100vw" width={c.w} height={c.h} loading="lazy" alt={c.alt} />
              </div>
              <div class="card-body">
                <span class="label">{p.no} <span aria-hidden="true">/</span> {p.engine}</span>
                <h3>{p.title} <span class="card-sub">{p.subtitle}</span></h3>
                <p>{p.summary}</p>
                <ul class="stats" role="list">
                  {p.stats.map((s) => (
                    <li><strong class="num" data-count={s.n}>{s.n}</strong><span>{s.label}</span></li>
                  ))}
                </ul>
                <span class="card-cta">{c.cta} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="wrap method" aria-labelledby="method-title">
      <div class="section-head">
        <span class="label">Method</span>
        <h2 id="method-title">How a pack arrives</h2>
      </div>
      <ol class="method-list" role="list">
        {method.map((m, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <span class="label num">0{i + 1}</span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap help" aria-labelledby="help-title">
      <div class="help-inner" data-reveal data-cursor-dark>
        <h2 id="help-title">Stuck on something?</h2>
        <p>Email support with the pack name, your Unity version and what you expected to happen. You will get a reply within two business days.</p>
        <a class="btn btn-sun" href="/contact.html" data-magnetic>Contact support <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    display: grid;
    align-content: end;
    min-height: min(100svh, 62rem);
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }
  .hero-kicker {
    margin-bottom: 1.25rem;
  }

  /* The wordmark: each letter swells and condenses near the pointer (micro.js) */
  .wordmark {
    font-size: var(--step-hero);
    font-weight: 560;
    font-stretch: 112%;
    letter-spacing: -0.055em;
    line-height: 0.84;
    margin-left: -0.05em;
    cursor: default;
  }
  .wordmark :global(.wm-word) {
    display: block;
    white-space: nowrap;
  }
  .wordmark :global(.wm-letter) {
    display: inline-block;
  }
  /* hidden only until the script splits it; shown anyway if the script is slow to arrive */
  :global(.js) .wordmark:not(:global(.wm-ready)) {
    opacity: 0;
    animation: appear 1ms 1.2s forwards;
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  .wordmark:global(.wm-ready) :global(.wm-letter) {
    animation: rise 900ms var(--ease) both;
    animation-delay: var(--d);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
      font-stretch: 62%;
    }
  }

  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 30rem) auto;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem 3rem;
    margin-top: clamp(2rem, 5vh, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .lede {
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink-2);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 52rem) {
    .hero-foot {
      grid-template-columns: 1fr;
    }
  }

  /* Pack index: one hairline row per pack */
  .packs {
    padding-top: 3rem;
  }
  .pack-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .pack-row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 8rem auto 2rem;
    align-items: center;
    gap: 1rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
    position: relative;
  }
  a.pack-row::before {
    content: "";
    position: absolute;
    inset: 0 calc(var(--gutter) * -0.5);
    z-index: -1;
    border-radius: 12px;
    background: var(--card);
    opacity: 0;
    transition: opacity 300ms;
  }
  a.pack-row:hover::before {
    opacity: 1;
  }
  .row-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }
  .row-name {
    font-size: var(--step-3);
    font-weight: 560;
    font-stretch: 112%;
    letter-spacing: -0.035em;
    line-height: 1;
    transition: font-stretch 500ms var(--ease), letter-spacing 500ms var(--ease);
  }
  a.pack-row:hover .row-name {
    font-stretch: 125%;
    letter-spacing: -0.03em;
  }
  .row-sub {
    color: var(--muted);
    font-stretch: 96%;
  }
  .row-arrow {
    justify-self: end;
    font-size: var(--step-1);
    transition: transform 500ms var(--ease);
  }
  a.pack-row:hover .row-arrow {
    transform: translateX(0.35rem) rotate(-45deg);
  }
  .is-quiet .row-name {
    color: var(--muted);
  }
  @media (max-width: 52rem) {
    .pack-row {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
      row-gap: 0.6rem;
    }
    .row-engine {
      display: none;
    }
    .pack-row .pill {
      grid-column: 2;
      grid-row: 2;
      justify-self: start;
    }
    .row-arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }

  /* Pack cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
    text-decoration: none;
    overflow: hidden;
    transform-style: preserve-3d;
    transition:
      transform 600ms var(--ease),
      box-shadow 600ms var(--ease);
  }
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(28rem circle at var(--mx, 50%) var(--my, 0%), rgb(255 255 255 / 0.22), transparent 55%);
    opacity: 0;
    transition: opacity 400ms;
    pointer-events: none;
  }
  .card:hover {
    box-shadow: 0 30px 60px -30px rgb(21 23 28 / 0.35);
  }
  .card:hover::after {
    opacity: 1;
  }
  .card-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--studio);
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.02;
    transition: scale 1200ms var(--ease);
  }
  .card:hover .card-media img {
    scale: 1.07;
  }
  .card-body {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.5rem 1.5rem 1.6rem;
  }
  .card h3 {
    font-size: var(--step-2);
    font-weight: 580;
    font-stretch: 114%;
    letter-spacing: -0.03em;
  }
  .card-sub {
    display: block;
    margin-top: 0.2rem;
    font-size: var(--step-0);
    font-weight: 450;
    font-stretch: 96%;
    letter-spacing: 0;
    color: var(--muted);
  }
  .card p {
    color: var(--ink-2);
    max-width: 30rem;
  }
  .stats {
    display: flex;
    gap: 2rem;
    margin: 0.5rem 0 0;
    padding: 0.9rem 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .stats li {
    display: grid;
  }
  .stats strong {
    font-size: var(--step-3);
    font-weight: 520;
    font-stretch: 100%;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .stats span {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .card-cta {
    margin-top: 0.5rem;
    font-weight: 560;
  }
  .card-cta span {
    display: inline-block;
    transition: transform 500ms var(--ease);
  }
  .card:hover .card-cta span {
    transform: translateX(0.3rem);
  }

  /* Method */
  .method {
    padding-top: clamp(4rem, 9vw, 7rem);
  }
  .method-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .method-list li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
    transition: border-color 400ms;
  }
  .method-list li:hover {
    border-color: var(--sun-deep);
  }
  .method-list p {
    color: var(--ink-2);
  }

  /* Help */
  .help {
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .help-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem) auto;
    align-items: end;
    gap: 1.5rem 3rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: 20px;
    background: var(--ink);
    color: var(--paper);
    --focus: var(--sun);
  }
  .help-inner p {
    color: rgb(243 242 238 / 0.72);
  }
  @media (max-width: 60rem) {
    .help-inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .help-inner .btn {
      justify-self: start;
    }
  }
</style>
