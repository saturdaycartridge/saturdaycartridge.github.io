---
import Base from "../layouts/Base.astro";

const email = "ifeonu95@gmail.com";
const faq = [
  {
    q: "The materials are pink. How do I fix that?",
    a: `Pink means the materials don't match your project's render pipeline. Each pack's documentation lists the pipelines it supports and how to switch. In Everyday Cars, which uses URP by default, a Built-in project needs RenderPipelines/BuiltIn_Materials.unitypackage from the pack folder: importing it replaces the materials in place, and the prefabs keep working.`,
  },
  {
    q: "Which Unity versions are supported?",
    a: "Each pack's store page lists the versions it supports. Everyday Cars works with Unity 2022.3 or newer, including Unity 6.",
  },
  {
    q: "Can I edit the models?",
    a: "Yes. Models come as FBX files that open in Blender, Maya or any other 3D package. In Everyday Cars the meshes are quad-dominant with solid-colour materials and no UVs; other packs list their topology and texturing on their store pages.",
  },
  {
    q: "Do the Everyday Cars vehicles drive?",
    a: "No, the pack is art only, with no driving physics or controller. Wheels and the steering wheel are separate objects with correct pivots, and a small component spins and steers them, so you can connect your own controller.",
  },
  {
    q: "Will there be packs for Unreal Engine?",
    a: "Yes, our first Unreal Engine packs are in the workshop. They will be listed on the home page as soon as they are announced.",
  },
];
---
<Base
  title="Contact and support"
  description="Get help with Saturday Cartridge asset packs: email support, what to include, and answers to common questions."
  current="support"
>
  <main id="main" class="support">
    <div class="wrap head">
      <h1>Contact and support</h1>
      <p>Questions, bug reports and licence queries about any Saturday Cartridge pack.</p>
    </div>

    <div class="wrap grid">
      <div class="stack">
        <section class="card mail" aria-labelledby="email-title">
          <h2 id="email-title">Email</h2>
          <a class="mail-link" href={`mailto:${email}`}>{email}</a>
          <p>Replies within two business days, Monday to Friday.</p>
        </section>

        <section aria-labelledby="include-title">
          <h2 id="include-title" class="h3">What to include</h2>
          <ul class="checklist">
            <li>The pack name and version (the version is at the end of the pack's Documentation/README.md)</li>
            <li>Your Unity version and render pipeline (URP or Built-in)</li>
            <li>What you expected and what happened, with a screenshot if you can</li>
            <li>Any errors from the Console</li>
          </ul>
        </section>

        <section aria-labelledby="business-title">
          <h2 id="business-title" class="h3">Business enquiries</h2>
          <p>For partnerships, press or custom work, use the same address and put "Business" in the subject line.</p>
        </section>
      </div>

      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Common questions</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
        <p class="eula">
          Packs are sold under the Unity Asset Store EULA, which allows use in your own games and apps but not reselling or
          sharing the assets on their own. The <a href="https://unity.com/legal/as-terms">Asset Store Terms of Service and EULA</a> have the full terms.
        </p>
      </section>
    </div>
  </main>
</Base>

<style>
  .support {
    padding-top: calc(var(--header-h) + clamp(1.5rem, 5vw, 4rem));
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  .head {
    display: grid;
    gap: 0.9rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 820;
    font-stretch: 120%;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }
  .head p {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 3rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .stack {
    display: grid;
    gap: 2.25rem;
  }
  h2 {
    font-size: var(--step-2);
    margin-bottom: 0.75rem;
  }
  .h3 {
    font-size: var(--step-1);
  }
  .card {
    padding: 1.4rem 1.5rem 1.5rem;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 14px;
    box-shadow: 0 6px 0 var(--ink);
  }
  .mail-link {
    display: inline-block;
    margin-bottom: 0.6rem;
    font-size: clamp(1.25rem, 0.9rem + 1.6vw, 1.875rem);
    font-weight: 720;
    font-stretch: 105%;
    letter-spacing: -0.01em;
    word-break: break-word;
  }
  .checklist {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .checklist li {
    position: relative;
    padding-left: 2rem;
    max-width: 34rem;
  }
  .checklist li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 1.05rem;
    height: 1.05rem;
    border: 2px solid var(--ink);
    border-radius: 4px;
    background: var(--sun);
  }
  .faq {
    padding: 1.6rem 1.6rem 1.4rem;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 14px;
  }
  details {
    border-top: 1px solid var(--mist);
  }
  details:first-of-type {
    border-top: 2px solid var(--ink);
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 0;
    font-weight: 660;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "";
    flex: none;
    width: 0.65rem;
    height: 0.65rem;
    margin-top: 0.4rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 160ms;
  }
  details[open] summary::after {
    transform: rotate(-135deg) translate(-0.2rem, -0.2rem);
  }
  details p {
    padding-bottom: 1.1rem;
    max-width: 38rem;
  }
  .eula {
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 2px solid var(--ink);
    font-size: var(--step--1);
  }
  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    summary::after {
      transition: none;
    }
  }
</style>
